<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.ViewModels"
             xmlns:views="using:XerahS.UI.Views"
             xmlns:controls="using:XerahS.UI.Controls"
             xmlns:converters="using:XerahS.UI.Converters"
             xmlns:local="using:XerahS.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="XerahS.UI.Views.TaskSettingsPanel"
             x:DataType="vm:TaskSettingsViewModel">

    <Design.DataContext>
        <vm:TaskSettingsViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TabControl Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" MinHeight="300">
            
            <!-- Capture Tab -->
            <TabItem Header="{local:Localize TaskSettings_Capture}">
                <ScrollViewer>
                    <StackPanel Spacing="24" Margin="20">
                        <!-- General Capture Settings -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize Settings_Tab_General}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseModernCapture}"
                                              Content="{local:Localize TaskSettings_UseModernCapture}"
                                              IsVisible="{Binding ShowUseModernCaptureSetting}"/>
                                    <StackPanel Spacing="10" IsVisible="{Binding IsLinuxPlatform}">
                                        <TextBlock Text="{local:Localize TaskSettings_PreferredLinuxRegionSelector}" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding LinuxRegionSelectorPreferences}"
                                                  SelectedItem="{Binding LinuxRegionSelectorPreference}"
                                                  HorizontalAlignment="Stretch"
                                                  MinWidth="240"
                                                  AutomationProperties.Name="Preferred Linux Region Selector">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{local:Localize TaskSettings_LinuxRegionSelectorNote}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="10" IsVisible="{Binding IsMacOSPlatform}">
                                        <TextBlock Text="{local:Localize TaskSettings_PreferredMacOSRegionSelector}" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding MacOSRegionSelectorPreferences}"
                                                  SelectedItem="{Binding MacOSRegionSelectorPreference}"
                                                  HorizontalAlignment="Stretch"
                                                  MinWidth="240"
                                                  AutomationProperties.Name="Preferred macOS Region Selector">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{local:Localize TaskSettings_MacOSRegionSelectorNote}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                        <CheckBox IsChecked="{Binding MacOSPlayCaptureSound}"
                                                  Content="{local:Localize Settings_Advanced_PlayMacCaptureSound}"
                                                  AutomationProperties.Name="Play Native macOS Capture Sound"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding ShowCursor}" Content="{local:Localize TaskSettings_ShowCursor}"/>
                                    
                                    <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, Auto, Auto">
                                        <!-- Screenshot Delay -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize TaskSettings_ScreenshotDelay}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <NumericUpDown Value="{Binding ScreenshotDelay}" Minimum="0" Maximum="60" Increment="0.1" FormatString="0.0" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="Screenshot Delay"/>
                                            <TextBlock Text="{local:Localize AutoCapture_Seconds}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Window Title -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Localize TaskSettings_WindowTitle}" VerticalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CaptureCustomWindow, UpdateSourceTrigger=PropertyChanged}" 
                                                 PlaceholderText="{local:Localize TaskSettings_WindowTitlePlaceholder}" Margin="0,16,0,0" AutomationProperties.Name="Window Title"/>
                                    </Grid>

                                    <StackPanel Spacing="10">
                                        <CheckBox IsChecked="{Binding CaptureTransparent}" Content="{local:Localize TaskSettings_CaptureTransparency}"/>
                                        <CheckBox IsChecked="{Binding CaptureShadow}" Content="{local:Localize TaskSettings_CaptureShadow}" IsEnabled="{Binding CaptureTransparent}" Margin="24,0,0,0"/>
                                        <CheckBox IsChecked="{Binding CaptureClientArea}" Content="{local:Localize TaskSettings_CaptureClientArea}"/>
                                        <CheckBox IsChecked="{Binding CaptureAutoHideTaskbar}" Content="{local:Localize TaskSettings_AutoHideTaskbar}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- After Capture Tasks Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize AfterCapture_AfterCapture}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{local:Localize TaskSettings_AfterCaptureDescription}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                               Margin="0,0,0,4"/>
                                    
                                    <CheckBox IsChecked="{Binding SaveImageToFile}" Content="{local:Localize AfterCapture_SaveImageToFile}"/>
                                    <CheckBox IsChecked="{Binding CopyImageToClipboard}" Content="{local:Localize AfterCapture_CopyImageToClipboard}"/>
                                    <CheckBox IsChecked="{Binding UploadImageToHost}" Content="{local:Localize AfterCapture_UploadImageToHost}" FontWeight="SemiBold"/>
                                    <CheckBox IsChecked="{Binding ApplyImageEffects}" Content="{local:Localize TaskSettings_ApplyImageEffects}"/>
                                    <CheckBox IsChecked="{Binding AnnotateMedia}" Content="{local:Localize AfterCapture_AnnotateMedia}"/>
                                    <CheckBox IsChecked="{Binding ShowAfterCaptureWindow}" Content="{local:Localize TaskSettings_ShowAfterCaptureWindow}"/>
                                    <CheckBox IsChecked="{Binding DoOCR}" Content="{local:Localize TaskSettings_OcrTextRecognition}"/>
                                    <CheckBox IsChecked="{Binding CopyOcrTextToClipboard}" Content="{local:Localize AfterCapture_CopyOcrTextToClipboard}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Index Folder Tab (Conditional) -->
            <TabItem Header="{local:Localize IndexFolder_Title}" IsVisible="{Binding IsIndexFolderJob}">
                <ScrollViewer>
                     <StackPanel Spacing="8" Margin="20">
                        <TextBlock Text="{local:Localize TaskSettings_IndexFolder}" FontWeight="SemiBold"/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto, 16, *, Auto">
                                    <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_Folder}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding IndexerFolderPath}" PlaceholderText="{local:Localize TaskSettings_FolderToIndex}" AutomationProperties.Name="Indexer Folder"/>
                                    <Button Grid.Column="3" Content="{local:Localize ImageAnalyzer_Browse}" Command="{Binding BrowseIndexerFolderCommand}" Margin="16,0,0,0"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_Output}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding IndexerOutputs}" SelectedItem="{Binding IndexerOutput}" MinWidth="200" HorizontalAlignment="Stretch" AutomationProperties.Name="Indexer Output Format"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_MaxDepth}" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding IndexerMaxDepthLevel}" Minimum="0" Maximum="50" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="Max Depth Level"/>
                                </Grid>

                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding IndexerSkipHiddenFolders}" Content="{local:Localize IndexFolder_SkipHiddenFolders}"/>
                                    <CheckBox IsChecked="{Binding IndexerSkipHiddenFiles}" Content="{local:Localize IndexFolder_SkipHiddenFiles}"/>
                                    <CheckBox IsChecked="{Binding IndexerSkipFiles}" Content="{local:Localize TaskSettings_SkipFiles}"/>
                                    <CheckBox IsChecked="{Binding IndexerShowSizeInfo}" Content="{local:Localize TaskSettings_ShowSizeInfo}"/>
                                    <CheckBox IsChecked="{Binding IndexerAddFooter}" Content="{local:Localize TaskSettings_AddFooter}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_Indentation}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding IndexerIndentationText}" MinWidth="200" HorizontalAlignment="Stretch" AutomationProperties.Name="Indentation Text"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding IndexerAddEmptyLineAfterFolders}" Content="{local:Localize IndexFolder_AddEmptyLineAfterFolders}"/>

                                <Separator Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Height="1"/>
                                
                                <TextBlock Text="{local:Localize TaskSettings_HtmlOptions}" FontWeight="SemiBold" FontSize="12"/>
                                <CheckBox IsChecked="{Binding IndexerUseCustomCssFile}" Content="{local:Localize IndexFolder_UseCustomCss}"/>
                                
                                <Grid ColumnDefinitions="Auto, 16, *, Auto" IsEnabled="{Binding IndexerUseCustomCssFile}">
                                    <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_CssPath}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding IndexerCustomCssFilePath}" AutomationProperties.Name="CSS File Path"/>
                                    <Button Grid.Column="3" Content="{local:Localize ImageAnalyzer_Browse}" Command="{Binding BrowseIndexerCssFileCommand}" Margin="16,0,0,0"/>
                                </Grid>
                                
                                <CheckBox IsChecked="{Binding IndexerDisplayPath}" Content="{local:Localize IndexFolder_DisplayPath}"/>
                                <CheckBox IsChecked="{Binding IndexerDisplayPathLimited}"
                                          Content="{local:Localize TaskSettings_LimitDisplayPath}"
                                          IsEnabled="{Binding IndexerDisplayPath}"
                                          Margin="24,0,0,0"/>

                                <Separator Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Height="1"/>
                                
                                <TextBlock Text="{local:Localize TaskSettings_XmlJsonOptions}" FontWeight="SemiBold" FontSize="12"/>
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding IndexerUseAttribute}" Content="{local:Localize TaskSettings_WriteFileInfoAsAttribute}"/>
                                    <CheckBox IsChecked="{Binding IndexerCreateParseableJson}" Content="{local:Localize IndexFolder_ParseableJson}"/>
                                    <CheckBox IsChecked="{Binding IndexerBinaryUnits}" Content="{local:Localize IndexFolder_BinaryUnits}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- File Tab (New) -->
            <TabItem Header="{local:Localize TaskSettings_File}">
                <ScrollViewer>
                     <StackPanel Spacing="8" Margin="20">
                        <TextBlock Text="{local:Localize TaskSettings_FileNaming}" FontWeight="SemiBold"/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_NamePattern}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding NameFormatPattern, Mode=TwoWay}" AutomationProperties.Name="Name Pattern"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_ActiveWindowNamePattern}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding NameFormatPatternActiveWindow, Mode=TwoWay}" AutomationProperties.Name="Active Window Name Pattern"/>
                                </Grid>
                                
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding FileUploadUseNamePattern}" Content="{local:Localize TaskSettings_UseNamePatternForFileUploaders}"/>
                                    <CheckBox IsChecked="{Binding FileUploadReplaceProblematicCharacters}" Content="{local:Localize TaskSettings_ReplaceProblematicCharacters}"/>
                                    <CheckBox IsChecked="{Binding URLRegexReplace}" Content="{local:Localize TaskSettings_PerformRegexReplace}"/>
                                </StackPanel>
                                
                                <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, 16, Auto" IsVisible="{Binding URLRegexReplace}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize TaskSettings_RegexPattern}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding URLRegexReplacePattern, Mode=TwoWay}" AutomationProperties.Name="URL Regex Pattern"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Localize TaskSettings_Replacement}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding URLRegexReplaceReplacement, Mode=TwoWay}" AutomationProperties.Name="URL Regex Replacement"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Upload Tab -->
            <TabItem Header="{local:Localize TaskSettings_Upload}">
               <ScrollViewer>
                   <StackPanel Spacing="24" Margin="20">
                        <!-- Destinations Section (New) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize TaskSettings_Destinations}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{local:Localize TaskSettings_SelectDestination}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding $parent[views:WorkflowEditorView].((vm:WorkflowEditorViewModel)DataContext).AvailableDestinations}"
                                              SelectedItem="{Binding $parent[views:WorkflowEditorView].((vm:WorkflowEditorViewModel)DataContext).SelectedDestination}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Select Destination"
                                              ToolTip.Tip="{local:Localize TaskSettings_DestinationToolTip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:UploaderInstanceViewModel">
                                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                                     <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Clipboard Upload -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize TaskSettings_ClipboardUpload}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding ClipboardUploadURLContents}" Content="{local:Localize TaskSettings_UploadUrlContents}"/>
                                    <CheckBox IsChecked="{Binding ClipboardUploadShortenURL}" Content="{local:Localize TaskSettings_ShortenUrl}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- After Upload Tasks -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize AfterUpload_Header}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{local:Localize TaskSettings_AfterUploadDescription}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                               Margin="0,0,0,4"/>
                                    <CheckBox IsChecked="{Binding ShowAfterUploadWindow}" 
                                              Content="{local:Localize AfterCapture_ShowAfterUploadWindow}"
                                              AutomationProperties.Name="Show After Upload Window"/>
                                    <CheckBox IsChecked="{Binding CopyURLToClipboard}" 
                                              Content="{local:Localize AfterCapture_CopyURLToClipboard}"/>
                                    <CheckBox IsChecked="{Binding UseURLShortener}" 
                                              Content="{local:Localize AfterCapture_UseURLShortener}"/>
                                    <CheckBox IsChecked="{Binding ShareURL}" 
                                              Content="{local:Localize AfterCapture_ShareURL}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                   </StackPanel>
               </ScrollViewer>
            </TabItem>

            <!-- Notifications Tab (Renamed from General) -->
            <TabItem Header="{local:Localize TaskSettings_Notifications}">
                <ScrollViewer>
                    <StackPanel Spacing="24" Margin="20">
                        <!-- Notifications Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize TaskSettings_Notifications}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="10">
                                        <CheckBox IsChecked="{Binding PlaySoundAfterCapture}" Content="{local:Localize TaskSettings_PlaySoundAfterCapture}"/>
                                        <CheckBox IsChecked="{Binding PlaySoundAfterUpload}" Content="{local:Localize TaskSettings_PlaySoundAfterUpload}"/>
                                        <CheckBox IsChecked="{Binding PlaySoundAfterAction}" Content="{local:Localize TaskSettings_PlaySoundAfterAction}"/>
                                        <CheckBox IsChecked="{Binding ShowToastNotification}" Content="{local:Localize TaskSettings_IncludeToastNotification}"/>
                                    </StackPanel>
                                    
                                    <!-- Toast Settings -->
                                    <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" 
                                          IsVisible="{Binding ShowToastNotification}" Margin="24,0,0,0">
                                        
                                        <!-- Duration -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize TaskSettings_Duration}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <NumericUpDown Value="{Binding ToastWindowDuration}" Minimum="0.5" Maximum="30" Increment="0.5" FormatString="0.0" MinWidth="120" AutomationProperties.Name="Toast Duration"/>
                                            <TextBlock Text="{local:Localize AutoCapture_Seconds}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Fade Duration -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Localize TaskSettings_FadeDuration}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <NumericUpDown Value="{Binding ToastWindowFadeDuration}" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.0" MinWidth="120" AutomationProperties.Name="Toast Fade Duration"/>
                                            <TextBlock Text="{local:Localize AutoCapture_Seconds}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Placement -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Localize TaskSettings_Placement}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ContentAlignments}" SelectedItem="{Binding ToastWindowPlacement}" HorizontalAlignment="Stretch" MinWidth="200" Margin="0,8,0,0" AutomationProperties.Name="Toast Placement"/>

                                        <!-- Size -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Localize TaskSettings_Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <NumericUpDown Value="{Binding ToastWindowWidth}" Minimum="100" Maximum="2000" Increment="10" MinWidth="120" AutomationProperties.Name="Toast Width"/>
                                            <TextBlock Text="{local:Localize TaskSettings_DimensionSeparator}" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding ToastWindowHeight}" Minimum="50" Maximum="1000" Increment="10" MinWidth="120" AutomationProperties.Name="Toast Height"/>
                                        </StackPanel>
                                        
                                        <!-- Auto Hide -->
                                         <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" IsChecked="{Binding ToastWindowAutoHide}" Content="{local:Localize TaskSettings_AutoHideToast}" Margin="0,8,0,0"/>

                                        <!-- Click Actions -->
                                        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, Auto, Auto" Margin="0,16,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize TaskSettings_LeftClick}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding ToastClickActions}" SelectedItem="{Binding ToastWindowLeftClickAction}" HorizontalAlignment="Stretch" AutomationProperties.Name="Left Click Action"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Localize TaskSettings_MiddleClick}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding ToastClickActions}" SelectedItem="{Binding ToastWindowMiddleClickAction}" HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="Middle Click Action"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Localize TaskSettings_RightClick}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                            <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ToastClickActions}" SelectedItem="{Binding ToastWindowRightClickAction}" HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="Right Click Action"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sound Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize TaskSettings_Sound}" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseCustomCaptureSound}" Content="{local:Localize TaskSettings_UseCustomCaptureSound}"/>
                                    <Grid ColumnDefinitions="Auto, 16, *" IsVisible="{Binding UseCustomCaptureSound}">
                                        <TextBlock Grid.Column="0" Text="{local:Localize TaskSettings_Path}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Text="{Binding CustomCaptureSoundPath}" AutomationProperties.Name="Sound File Path"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Advanced Tab -->
            <TabItem Header="{local:Localize Settings_Tab_Advanced}">
                <Grid Margin="24" RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="{local:Localize TaskSettings_AdvancedProperties}"
                                FontWeight="SemiBold"
                                Margin="0,0,0,12"/>
                    <Border Grid.Row="1"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            CornerRadius="4"
                            Padding="8">
                        <controls:PropertyGrid SelectedObject="{Binding AdvancedSettings}"
                                               AutomationProperties.Name="Advanced Task Settings"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
