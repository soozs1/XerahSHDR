<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:XerahS.UI.Markup"
        x:Class="XerahS.UI.Views.Dialogs.OpenImageChoiceDialog"
        Classes="xerahs-surface"
        Title="{local:Localize MainWindow_OpenImageTitle}"
        Width="460"
        Height="200"
        MinWidth="460"
        MinHeight="200"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="16">
        <StackPanel Spacing="12">
            <TextBlock Text="{local:Localize OpenImageChoice_AlreadyOpen}"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{local:Localize OpenImageChoice_Prompt}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{local:Localize OpenImageChoice_AddAsShape}"
                        Click="OnAddClick"/>
                <Button Content="{local:Localize OpenImageChoice_ReplaceImage}"
                        Click="OnReplaceClick"/>
                <Button Content="{local:Localize SendToAction_Cancel}"
                        Click="OnCancelClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
