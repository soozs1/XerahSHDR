<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                xmlns:views="using:XerahS.UI.Views"
                xmlns:viewcontrols="using:XerahS.UI.Views.Controls"
                xmlns:vm="using:XerahS.UI.ViewModels"
                xmlns:controls="using:XerahS.UI.Controls"
                xmlns:converters="using:XerahS.UI.Converters"
                xmlns:local="using:XerahS.UI.Markup"
                x:Class="XerahS.UI.Views.ApplicationSettingsView"
                x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <views:PageView.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </views:PageView.Resources>

    <Grid RowDefinitions="Auto, *"
          Margin="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <TabControl Grid.Row="1"
                    x:Name="ApplicationSettingsTabs"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
            <!-- General Tab -->
            <TabItem Header="{local:Localize Settings_Tab_General}">
                <ScrollViewer controls:SettingsSearch.PageId="general">
                    <StackPanel Spacing="24" Margin="24">
                        
                        <!-- Theme -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Theme_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Theme_ApplicationTheme}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding ThemeModes}"
                                                  SelectedItem="{Binding ThemeMode}"
                                                  MinWidth="200"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Application Theme"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Theme_Language}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  SelectedItem="{Binding SelectedLanguage}"
                                                  MinWidth="200"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Language">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{local:Localize Settings_Theme_LanguageRestartNote}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{local:Localize Settings_Theme_SystemDefaultNote}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Updates -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Updates_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding AutoCheckUpdate}" Content="{local:Localize Settings_Updates_AutoCheck}" AutomationProperties.Name="Auto Check Update"/>
                                    
                                    <Grid ColumnDefinitions="*, 16, *" RowDefinitions="Auto, 12, Auto">
                                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Updates_UpdateChannel}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding UpdateChannels}"
                                                      SelectedItem="{Binding UpdateChannel}"
                                                      IsEnabled="{Binding AutoCheckUpdate}"
                                                      HorizontalAlignment="Stretch" MinWidth="160"
                                                      AutomationProperties.Name="Update Channel"/>
                                        </Grid>

                                        <Grid Grid.Column="2" Grid.Row="0"
                                              ColumnDefinitions="Auto, 16, *"
                                              IsVisible="{Binding ShowPreReleaseSourceSettings}">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Updates_PreReleaseSource}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding PreReleaseUpdateSources}"
                                                      SelectedItem="{Binding PreReleaseUpdateSource}"
                                                      IsEnabled="{Binding AutoCheckUpdate}"
                                                      HorizontalAlignment="Stretch" MinWidth="160"
                                                      AutomationProperties.Name="Pre-release Source"/>
                                        </Grid>

                                        <Grid Grid.Column="2" Grid.Row="2"
                                              ColumnDefinitions="Auto, 16, *"
                                              IsVisible="{Binding ShowCustomPreReleaseSource}">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Updates_CustomSource}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding CustomPreReleaseUpdateSource}"
                                                     PlaceholderText="{local:Localize Settings_Updates_CustomSourcePlaceholder}"
                                                     IsEnabled="{Binding AutoCheckUpdate}"
                                                     HorizontalAlignment="Stretch" MinWidth="160"
                                                     AutomationProperties.Name="Custom Pre-release Source"/>
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <Button Grid.Column="0"
                                                Content="{Binding ManualUpdateButtonText}"
                                                Command="{Binding ManualUpdateCommand}"
                                                IsEnabled="{Binding CanTriggerManualUpdate}"
                                                MinWidth="120"
                                                AutomationProperties.Name="Update Now"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ManualUpdateStatusText}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Notifications -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Notifications_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding DisableToastNotification}"
                                              Content="{local:Localize Settings_Notifications_DisableWindow}"
                                              ToolTip.Tip="{local:Localize Settings_Notifications_DisableWindowToolTip}"
                                              AutomationProperties.Name="Disable Notification Window"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Tray Icon -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_TrayIcon_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding TrayIconProgressEnabled}" Content="{local:Localize Settings_TrayIcon_ShowProgress}" AutomationProperties.Name="Show Tray Progress"/>
                                    <CheckBox IsChecked="{Binding UseWhiteShareXIcon}"
                                              Content="{local:Localize Settings_TrayIcon_UseWhiteIcon}"
                                              ToolTip.Tip="{local:Localize Settings_TrayIcon_UseWhiteIconToolTip}"
                                              AutomationProperties.Name="Use White Tray Icon"/>
                                    
                                    <TextBlock Text="{local:Localize Settings_TrayIcon_ClickActions}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>

                                    <Grid ColumnDefinitions="120, 16, *" RowDefinitions="Auto, 16, Auto, 16, Auto">
                                        <!-- Row 0: Left Click -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize Settings_TrayIcon_LeftClick}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="2" 
                                                  ItemsSource="{Binding TrayClickActions}"
                                                  SelectedItem="{Binding TrayLeftClickAction}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Tray Left Click Action"/>

                                        <!-- Row 2: Double Click -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Localize Settings_TrayIcon_DoubleClick}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="2" 
                                                  ItemsSource="{Binding TrayClickActions}"
                                                  SelectedItem="{Binding TrayLeftDoubleClickAction}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Tray Double Click Action"/>

                                        <!-- Row 4: Middle Click -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{local:Localize Settings_TrayIcon_MiddleClick}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="4" Grid.Column="2" 
                                                  ItemsSource="{Binding TrayClickActions}"
                                                  SelectedItem="{Binding TrayMiddleClickAction}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Tray Middle Click Action"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Taskbar -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Taskbar_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <CheckBox IsChecked="{Binding TaskbarProgressEnabled}" Content="{local:Localize Settings_Taskbar_ShowProgress}" AutomationProperties.Name="Show Taskbar Progress"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Paths Tab -->
            <TabItem Header="{local:Localize Settings_Tab_Paths}">
                <ScrollViewer controls:SettingsSearch.PageId="paths">
                    <StackPanel Spacing="24" Margin="24">
                         <!-- Screenshots Folder -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Paths_ScreenshotsFolder}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseCustomScreenshotsPath}" Content="{local:Localize Settings_Paths_UseCustomScreenshotsPath}" AutomationProperties.Name="Use Custom Screenshots Path"/>
                                    <Grid ColumnDefinitions="*, 16, Auto" IsEnabled="{Binding UseCustomScreenshotsPath}">
                                        <TextBox Grid.Column="0" Text="{Binding ScreenshotsFolder}" PlaceholderText="{local:Localize Settings_Paths_ScreenshotsPathPlaceholder}" AutomationProperties.Name="Screenshots Folder Path"/>
                                        <Button Grid.Column="2"
                                                Width="36"
                                                MinWidth="36"
                                                Padding="0"
                                                Content="..."
                                                ToolTip.Tip="{local:Localize Settings_Paths_BrowseScreenshotsToolTip}"
                                                Command="{Binding BrowseFolderCommand}"
                                                AutomationProperties.Name="Browse Screenshots Folder"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Subfolder Pattern -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Paths_SubfolderPattern}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseSaveImageSubFolderPattern}" Content="{local:Localize Settings_Paths_UseSubfolderPattern}" AutomationProperties.Name="Use Subfolder Pattern"/>
                                    <Grid ColumnDefinitions="Auto, 16, *" IsEnabled="{Binding UseSaveImageSubFolderPattern}">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Paths_Pattern}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Text="{Binding SaveImageSubFolderPattern}" PlaceholderText="%y-%mo" AutomationProperties.Name="Subfolder Pattern"/>
                                    </Grid>
                                    <TextBlock Text="{local:Localize Settings_Paths_PatternExample}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Watch Folders Tab -->
            <TabItem Header="{local:Localize Settings_Tab_WatchFolders}">
                <ScrollViewer controls:SettingsSearch.PageId="watch-folders">
                    <StackPanel Spacing="24" Margin="24">
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_WatchFolders_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{local:Localize Settings_WatchFolders_Description}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="*, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_WatchFolders_ConfiguredFolders}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button Content="{local:Localize Settings_WatchFolders_Add}" Command="{Binding AddWatchFolderCommand}" AutomationProperties.Name="Add Watch Folder"/>
                                            <Button Content="{local:Localize Settings_WatchFolders_Edit}" Command="{Binding EditWatchFolderCommand}" AutomationProperties.Name="Edit Watch Folder"/>
                                            <Button Content="{local:Localize Settings_WatchFolders_Remove}" Command="{Binding RemoveWatchFolderCommand}" AutomationProperties.Name="Remove Watch Folder"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Watch Folder List Header -->
                                    <Grid ColumnDefinitions="80, 90, 2*, 150, 120, 120, 150, 120" Margin="4,0,4,0">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_WatchFolders_Column_Enabled}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{local:Localize Settings_WatchFolders_Column_Status}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{local:Localize Settings_WatchFolders_Column_Folder}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{local:Localize Settings_WatchFolders_Column_Workflow}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{local:Localize Settings_WatchFolders_Column_Filter}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="{local:Localize Settings_WatchFolders_Column_Subfolders}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="6" Text="{local:Localize Settings_WatchFolders_Column_MoveToScreenshots}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="7" Text="{local:Localize Settings_WatchFolders_Column_MovToMp4}" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>

                                    <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="4">
                                        <ListBox ItemsSource="{Binding WatchFolders}"
                                                 SelectedItem="{Binding SelectedWatchFolder}"
                                                 MinHeight="140"
                                                 AutomationProperties.Name="Watch Folders List">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WatchFolderSettingsViewModel">
                                                    <Grid ColumnDefinitions="80, 90, 2*, 150, 120, 120, 150, 120" Margin="6">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enable Watch Folder"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusDetail}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FolderPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FolderPath}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding WorkflowName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkflowName}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Filter}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding IncludeSubdirectoriesText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding MoveFilesToScreenshotsFolderText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding ConvertMovToMp4BeforeProcessingText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_WatchFolderDaemon_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{local:Localize Settings_WatchFolderDaemon_Description}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="Auto, 16, *"
                                          IsVisible="{Binding ShowWatchFolderDaemonScopeSelector}">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_WatchFolderDaemon_Scope}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding WatchFolderDaemonScopes}"
                                                  SelectedItem="{Binding WatchFolderDaemonScope}"
                                                  MinWidth="180"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Watch Folder Daemon Scope"/>
                                    </Grid>

                                    <CheckBox IsChecked="{Binding WatchFolderDaemonStartAtStartup}"
                                              Content="{local:Localize Settings_WatchFolderDaemon_StartAtStartup}"
                                              AutomationProperties.Name="Watch Folder Daemon Startup"/>

                                    <Grid ColumnDefinitions="*, 12, Auto, 8, Auto"
                                          VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding WatchFolderDaemonStatusText}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding WatchFolderDaemonLastError}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="{local:Localize Settings_WatchFolderDaemon_Refresh}"
                                                Command="{Binding RefreshWatchFolderDaemonStatusCommand}"
                                                AutomationProperties.Name="Refresh Watch Folder Daemon Status"/>

                                        <Button Grid.Column="4"
                                                Content="{Binding WatchFolderDaemonButtonText}"
                                                Command="{Binding ToggleWatchFolderDaemonCommand}"
                                                IsEnabled="{Binding WatchFolderDaemonSupported}"
                                                AutomationProperties.Name="Toggle Watch Folder Daemon"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Integration Tab -->
            <TabItem Header="{local:Localize Settings_Tab_Integration}">
                <ScrollViewer controls:SettingsSearch.PageId="integration">
                    <StackPanel Spacing="24" Margin="24">
                        <!-- System -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Integration_System}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding ShowTray}" Content="{local:Localize Settings_Integration_ShowTrayIcon}" AutomationProperties.Name="Show Tray Icon"/>
                                    <CheckBox IsChecked="{Binding SilentRun}" Content="{local:Localize Settings_Integration_StartMinimized}"
                                              IsEnabled="{Binding ShowTray}" AutomationProperties.Name="Start Minimized"/>
                                    <CheckBox IsChecked="{Binding RememberMainWindowSize}"
                                              Content="{local:Localize Settings_Integration_RememberMainWindowSize}"
                                              AutomationProperties.Name="Remember Main Window Size"/>
                                    <CheckBox IsChecked="{Binding RememberMainWindowPosition}"
                                              Content="{local:Localize Settings_Integration_RememberMainWindowPosition}"
                                              AutomationProperties.Name="Remember Main Window Position"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Desktop Integration -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Integration_DesktopIntegration}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding RunAtStartup}" 
                                              Content="{local:Localize Settings_Integration_RunAtStartup}" AutomationProperties.Name="Run at Startup"/>
                                    <CheckBox IsChecked="{Binding EnableContextMenuIntegration}" 
                                              Content="{local:Localize Settings_Integration_ContextMenu}"
                                              IsEnabled="{Binding SupportsContextMenuIntegration}"
                                              ToolTip.Tip="{local:Localize Settings_Integration_ContextMenuToolTip}"
                                              AutomationProperties.Name="Enable Context Menu Integration"/>
                                    <CheckBox IsChecked="{Binding EnableSendToIntegration}" 
                                              Content="{local:Localize Settings_Integration_SendToMenu}"
                                              IsEnabled="{Binding SupportsSendToIntegration}"
                                              ToolTip.Tip="{local:Localize Settings_Integration_SendToMenuToolTip}"
                                              AutomationProperties.Name="Enable Send To Integration"/>

                                    <Border BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{local:Localize Settings_Integration_SendToRememberedChoices}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding RememberedSendToChoicesSummary}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="{local:Localize Settings_Integration_ClearSendToChoices}"
                                                    Command="{Binding ClearRememberedSendToChoicesCommand}"
                                                    IsEnabled="{Binding HasRememberedSendToChoices}"
                                                    HorizontalAlignment="Left"
                                                    AutomationProperties.Name="Clear Remembered Send To Choices"/>
                                        </StackPanel>
                                    </Border>

                                    <Border BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="12">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{local:Localize Settings_Integration_SendToDefaultPolicies}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>
                                            <Grid ColumnDefinitions="Auto, 16, *">
                                                <TextBlock Grid.Column="0" Text="{local:Localize Settings_Integration_FolderPolicy}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding SendToDefaultFolderPolicyOptions}"
                                                          SelectedItem="{Binding SendToDefaultFolderPolicy}"
                                                          HorizontalAlignment="Stretch"
                                                          MinWidth="200"
                                                          AutomationProperties.Name="Send-to Default Folder Policy"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, 16, *">
                                                <TextBlock Grid.Column="0" Text="{local:Localize Settings_Integration_ImageBatchPolicy}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding SendToDefaultBatchPolicyOptions}"
                                                          SelectedItem="{Binding SendToDefaultBatchPolicy}"
                                                          HorizontalAlignment="Stretch"
                                                          MinWidth="200"
                                                          AutomationProperties.Name="Send-to Default Batch Policy"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, 16, *">
                                                <TextBlock Grid.Column="0" Text="{local:Localize Settings_Integration_BatchConfirmThreshold}" VerticalAlignment="Center"/>
                                                <NumericUpDown Grid.Column="2"
                                                               Value="{Binding SendToDefaultBatchThreshold}"
                                                               Minimum="1" Maximum="100"
                                                               MinWidth="120" HorizontalAlignment="Stretch"
                                                               AutomationProperties.Name="Send-to Default Batch Threshold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{local:Localize Settings_Integration_Clipboard}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>

                                    <CheckBox IsChecked="{Binding EnableClipboardContentViewer}"
                                              Content="{local:Localize Settings_Integration_ClipboardViewer}"
                                              ToolTip.Tip="{local:Localize Settings_Integration_ClipboardViewerToolTip}"
                                              AutomationProperties.Name="Enable Clipboard Content Viewer"/>
                                              
                                    <TextBlock Text="{local:Localize Settings_Integration_FileAssociations}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                                    
                                    <CheckBox Content="{local:Localize Settings_Integration_AssociateXsdp}"
                                              IsChecked="{Binding IsPluginExtensionRegistered}"
                                              IsVisible="{Binding SupportsFileAssociations}"
                                              ToolTip.Tip="{local:Localize Settings_Integration_AssociateXsdpToolTip}"
                                              AutomationProperties.Name="Associate XSDP Files"/>
                                    
                                    <TextBlock Text="{local:Localize Settings_Integration_Note}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Capture Command Palette -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_CapturePalette_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{local:Localize Settings_CapturePalette_Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding CaptureCommandPaletteEnabled}"
                                              Content="{local:Localize Settings_CapturePalette_Enable}"
                                              AutomationProperties.Name="Enable Capture Command Palette"/>

                                    <Grid ColumnDefinitions="Auto, 16, *, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Shortcut}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding CaptureCommandPaletteHotkeyText}"
                                                 IsReadOnly="True"
                                                 AutomationProperties.Name="Capture Command Palette Shortcut"/>
                                        <Button Grid.Column="4"
                                                Content="{local:Localize Settings_TestShortcut}"
                                                Command="{Binding TestCaptureCommandPaletteShortcutCommand}"
                                                AutomationProperties.Name="Test Capture Command Palette Shortcut"/>
                                    </Grid>

                                    <TextBlock Text="{Binding CaptureCommandPaletteStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Assistant -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Assistant_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{local:Localize Settings_Assistant_Description}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding AssistantEnabled}"
                                              Content="{local:Localize Settings_Assistant_Enable}"
                                              AutomationProperties.Name="Enable Assistant"/>

                                    <Grid ColumnDefinitions="Auto, 16, *, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Shortcut}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantHotkeyText}"
                                                 IsReadOnly="True"
                                                 AutomationProperties.Name="Assistant Shortcut"/>
                                        <Button Grid.Column="4"
                                                Content="{local:Localize Settings_TestShortcut}"
                                                Command="{Binding TestAssistantShortcutCommand}"
                                                AutomationProperties.Name="Test Assistant Shortcut"/>
                                    </Grid>

                                    <TextBlock Text="{Binding AssistantHotkeyStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding AssistantPromptHistoryEnabled}"
                                              Content="{local:Localize Settings_Assistant_SaveHistory}"
                                              AutomationProperties.Name="Save Assistant History"/>

                                    <TextBlock Text="{local:Localize Settings_Assistant_AIProvider}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Margin="0,8,0,0"/>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Assistant_Provider}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding AssistantProviderOptions}"
                                                  SelectedItem="{Binding SelectedAssistantProvider}"
                                                  MinWidth="220"
                                                  AutomationProperties.Name="Assistant AI Provider">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AssistantProviderOptionViewModel">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Assistant_Model}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantProviderModelId}"
                                                 PlaceholderText="{local:Localize Settings_Assistant_ModelIdPlaceholder}"
                                                 AutomationProperties.Name="Assistant AI Model"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Assistant_BaseUrl}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantProviderBaseUrl}"
                                                 PlaceholderText="https://api.example.com/v1"
                                                 AutomationProperties.Name="Assistant AI Base URL"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Assistant_ApiKey}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AssistantProviderApiKey}"
                                                 PasswordChar="*"
                                                 PlaceholderText="{local:Localize Settings_Assistant_ApiKeyPlaceholder}"
                                                 IsEnabled="{Binding AssistantProviderNeedsApiKey}"
                                                 AutomationProperties.Name="Assistant AI API Key"/>
                                    </Grid>

                                    <TextBlock Text="{Binding AssistantProviderKeyStatus}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{local:Localize Settings_Assistant_SaveProvider}"
                                                Command="{Binding SaveAssistantProviderSettingsCommand}"
                                                AutomationProperties.Name="Save Assistant AI Provider"/>
                                        <Button Content="{local:Localize Settings_Assistant_Validate}"
                                                Command="{Binding ValidateAssistantProviderCommand}"
                                                AutomationProperties.Name="Validate Assistant AI Provider"/>
                                        <Button Content="{local:Localize Settings_Assistant_RemoveKey}"
                                                Command="{Binding RemoveAssistantProviderKeyCommand}"
                                                IsEnabled="{Binding AssistantProviderHasApiKey}"
                                                AutomationProperties.Name="Remove Assistant AI Key"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding AssistantProviderStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- MCP Server -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Mcp_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{local:Localize Settings_Mcp_Description}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Mcp_ManifestUrl}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding McpManifestUrl}"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="MCP Manifest URL"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Assistant_ApiKey}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding McpApiKeyDisplay}"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="MCP API Key Preview"/>
                                    </Grid>

                                    <TextBlock Text="{Binding McpApiKeyStatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{local:Localize Settings_Mcp_CopyApiKey}"
                                                Command="{Binding CopyMcpApiKeyCommand}"
                                                AutomationProperties.Name="Copy MCP API Key"/>
                                        <Button Content="{local:Localize Settings_Mcp_GenerateApiKey}"
                                                Command="{Binding GenerateMcpApiKeyCommand}"
                                                AutomationProperties.Name="Generate MCP API Key"/>
                                        <Button Content="{local:Localize Settings_Mcp_CopyManifestUrl}"
                                                Command="{Binding CopyMcpManifestUrlCommand}"
                                                AutomationProperties.Name="Copy MCP Manifest URL"/>
                                    </StackPanel>

                                    <TextBlock Text="{local:Localize Settings_Mcp_HttpTransportNote}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="{local:Localize Settings_Tab_History}">
                <ScrollViewer controls:SettingsSearch.PageId="history">
                    <StackPanel Spacing="24" Margin="24">
                        <!-- History Settings -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_History_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding HistorySaveTasks}" Content="{local:Localize Settings_History_SaveTasks}" AutomationProperties.Name="Save Tasks to History"/>
                                    <CheckBox IsChecked="{Binding HistoryCheckURL}" Content="{local:Localize Settings_History_OnlySaveWithUrl}" AutomationProperties.Name="Only Save Tasks with URL"/>
                                    <CheckBox IsChecked="{Binding ScreenshotContentSearchEnabled}"
                                              Content="{local:Localize Settings_History_ScreenshotSearch}"
                                              AutomationProperties.Name="Make Screenshots Searchable"/>
                                    <TextBlock Text="{local:Localize Settings_History_ScreenshotSearchNote}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recent Tasks Settings -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_RecentTasks_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1" 
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding RecentTasksSave}" Content="{local:Localize Settings_RecentTasks_Save}" AutomationProperties.Name="Save Recent Tasks"/>
                                    
                                    <Grid ColumnDefinitions="Auto, 16, Auto">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_RecentTasks_MaxCount}" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="2" 
                                                       Value="{Binding RecentTasksMaxCount}" 
                                                       Minimum="1" Maximum="100" 
                                                       MinWidth="120" HorizontalAlignment="Stretch"
                                                       AutomationProperties.Name="Max Recent Tasks"/>
                                    </Grid>
                                    
                                    <TextBlock Text="{local:Localize Settings_RecentTasks_DisplayOptions}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                                    
                                    <CheckBox IsChecked="{Binding RecentTasksShowInMainWindow}" Content="{local:Localize Settings_RecentTasks_ShowInMainWindow}" AutomationProperties.Name="Show Recent Tasks in Main Window"/>
                                    <CheckBox IsChecked="{Binding RecentTasksShowInTrayMenu}" Content="{local:Localize Settings_RecentTasks_ShowInTrayMenu}" AutomationProperties.Name="Show Recent Tasks in Tray Menu"/>
                                    <CheckBox IsChecked="{Binding RecentTasksTrayMenuMostRecentFirst}" 
                                              Content="{local:Localize Settings_RecentTasks_MostRecentFirst}" 
                                              IsEnabled="{Binding RecentTasksShowInTrayMenu}"
                                              AutomationProperties.Name="Show Recent Tasks First"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

             <!-- Proxy Tab -->
            <TabItem Header="{local:Localize Settings_Tab_Proxy}">
                <ScrollViewer controls:SettingsSearch.PageId="proxy">
                    <StackPanel Spacing="24" Margin="24">

                        <!-- Proxy Method -->
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Proxy_Title}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="Auto, 16, *">
                                        <TextBlock Grid.Column="0" Text="{local:Localize Settings_Proxy_Method}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding ProxyMethods}"
                                                  SelectedItem="{Binding ProxyMethod}"
                                                  HorizontalAlignment="Stretch" MinWidth="200"
                                                  AutomationProperties.Name="Proxy Method"/>
                                    </Grid>
                                    <TextBlock Text="{local:Localize Settings_Proxy_MethodDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Manual Proxy Settings -->
                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsManualProxy}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Proxy_Server}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Proxy_Host}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding ProxyHost}"
                                                     PlaceholderText="proxy.example.com"
                                                     AutomationProperties.Name="Proxy Host"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Proxy_Port}" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="2"
                                                           Value="{Binding ProxyPort}"
                                                           Minimum="1" Maximum="65535"
                                                           MinWidth="120" HorizontalAlignment="Stretch"
                                                           AutomationProperties.Name="Proxy Port"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Authentication -->
                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsManualProxy}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Proxy_Authentication}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Proxy_Username}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding ProxyUsername}"
                                                     PlaceholderText="{local:Localize Settings_Proxy_UsernamePlaceholder}"
                                                     AutomationProperties.Name="Proxy Username"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="100, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Proxy_Password}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding ProxyPassword}"
                                                     PlaceholderText="{local:Localize Settings_Proxy_PasswordPlaceholder}"
                                                     PasswordChar="•"
                                                     AutomationProperties.Name="Proxy Password"/>
                                        </Grid>
                                        <TextBlock Text="{local:Localize Settings_Proxy_AuthNote}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

             <!-- Advanced Tab -->
             <TabItem Header="{local:Localize Settings_Tab_Advanced}">
                <ScrollViewer controls:SettingsSearch.PageId="advanced">
                    <StackPanel Spacing="24" Margin="24">
                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding ShowUseModernCaptureSetting}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Advanced_CaptureEngine}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <CheckBox IsChecked="{Binding UseModernCapture}" Content="{local:Localize Settings_Advanced_UseModernCapture}" AutomationProperties.Name="Use Modern Capture"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsMacOSPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Advanced_MacRegionSelector}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="{local:Localize Settings_Advanced_MacRegionSelectorDescription}"
                                                   TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="120, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_RegionSelector}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding MacOSRegionSelectorPreferences}"
                                                      SelectedItem="{Binding MacOSRegionSelectorPreference}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="240"
                                                      AutomationProperties.Name="macOS Region Selector">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Object">
                                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="{local:Localize Settings_Advanced_MacRegionSelectorNote}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                        <CheckBox IsChecked="{Binding MacOSPlayCaptureSound}"
                                                  Content="{local:Localize Settings_Advanced_PlayMacCaptureSound}"
                                                  AutomationProperties.Name="Play Native macOS Capture Sound"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Advanced_LinuxRegionSelector}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="{local:Localize Settings_Advanced_LinuxRegionSelectorDescription}"
                                                   TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="120, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_RegionSelector}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding LinuxRegionSelectorPreferences}"
                                                      SelectedItem="{Binding LinuxRegionSelectorPreference}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="240"
                                                      AutomationProperties.Name="Linux Region Selector">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Object">
                                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding LinuxRegionSelectorCurrentSessionText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorPortalBackendText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorAvailableText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorAutomaticText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LinuxRegionSelectorLastDecisionText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Advanced_LinuxRecordingBackend}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="{local:Localize Settings_Advanced_LinuxRecordingBackendDescription}"
                                                   TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="120, 16, *">
                                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_Advanced_RecordingBackend}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding LinuxRecordingBackendPreferences}"
                                                      SelectedItem="{Binding LinuxRecordingBackendPreference}"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="240"
                                                      AutomationProperties.Name="Linux Recording Backend">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:Object">
                                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="{local:Localize Settings_Advanced_LinuxRecordingBackendNote}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Advanced_LinuxClipboard}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="12">
                                        <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12"
                                                IsVisible="{Binding ShowLinuxClipboardCliWarning}">
                                            <TextBlock Text="{Binding LinuxClipboardCliWarningText}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"/>
                                        </Border>
                                        <CheckBox IsChecked="{Binding PersistClipboardAfterExit}"
                                                  Content="{local:Localize Settings_Advanced_PersistClipboard}"
                                                  AutomationProperties.Name="Persist Clipboard After Exit"/>
                                        <TextBlock Text="{local:Localize Settings_Advanced_LinuxClipboardNote}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel controls:SettingsSearch.IsAvailabilityContainer="True" IsVisible="{Binding IsLinuxPlatform}">
                            <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                                <TextBlock Text="{local:Localize Settings_Advanced_WaylandPortalServices}" FontWeight="SemiBold"/>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="16">
                                        <CheckBox IsChecked="{Binding LinuxUseWaylandPortalServices}"
                                                  Content="{local:Localize Settings_Advanced_UseWaylandPortalServices}"
                                                  AutomationProperties.Name="Use Wayland Portal Services"/>
                                        <TextBlock Text="{local:Localize Settings_Advanced_WaylandPortalServicesNote}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Spacing="8" controls:SettingsSearch.IsPanel="True">
                            <TextBlock Text="{local:Localize Settings_Advanced_ApplicationConfiguration}" FontWeight="SemiBold"/>
                            <Border BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="16">
                                <controls:PropertyGrid x:Name="ApplicationConfigPropertyGrid"
                                                       SelectedObject="{Binding ApplicationConfig}"
                                                       AutomationProperties.Name="Application Config Properties"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</views:PageView>
